# Address that Locoris devices can actually reach. Use HTTPS outside a trusted LAN.
LOCORIS_PORT=26747
LOCORIS_PUBLIC_URL=http://localhost:26747

# Pin production installs to a numbered release. The website publishes the current value.
LOCORIS_SERVER_VERSION=latest

# Optional disaster-recovery override. Normal devices use one-time pairing instead.
LOCORIS_RECOVERY_TOKEN=
