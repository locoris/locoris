{
  "name": "@locoris/app",
  "private": true,
  "version": "1.0.50",
  "license": "AGPL-3.0-or-later",
  "author": "angrein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locoris/locoris.git",
    "directory": "apps/app"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ../../scripts/copy-legal-notices.mjs apps/app/dist",
    "web:build": "tsc -b && vite build --mode web && node ../../scripts/copy-legal-notices.mjs apps/app/dist && node ./scripts/validate-web-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:node && npm run test:localization",
    "test:node": "node --test tests/googleDriveSyncV2.test.ts tests/cloudBindingRecovery.test.ts tests/androidSigningOutput.test.ts tests/releaseMetadataSelection.test.ts",
    "test:localization": "vitest run --config vitest.config.ts",
    "tauri": "tauri",
    "desktop:dev": "node ./scripts/run-tauri.mjs dev",
    "desktop:build": "node ./scripts/run-tauri.mjs build",
    "desktop:build:debug": "node ./scripts/run-tauri.mjs build --debug",
    "desktop:info": "tauri info",
    "android:init": "tauri android init --ci",
    "android:dev": "tauri android dev",
    "android:studio": "tauri android dev --open",
    "android:build:apk": "tauri android build --apk --ci",
    "android:build:apk:debug": "tauri android build --debug --apk --ci"
  },
  "dependencies": {
    "@blocknote/core": "^0.47.3",
    "@blocknote/mantine": "^0.47.3",
    "@blocknote/react": "^0.47.3",
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/utils": "^6.0.22",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
