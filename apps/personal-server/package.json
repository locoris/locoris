{
  "name": "@locoris/personal-server",
  "version": "0.1.6",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": false,
  "author": "angrein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locoris/locoris.git",
    "directory": "apps/personal-server"
  },
  "homepage": "https://github.com/locoris/locoris/tree/main/apps/personal-server",
  "desktopName": "locoris-server",
  "description": "Private multi-vault self-hosted sync server for Locoris",
  "scripts": {
    "start": "node server.mjs",
    "sync-server": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:prepare": "node scripts/build-desktop-runtime.mjs",
    "desktop:dev": "npm run desktop:prepare && electron desktop-main.mjs",
    "desktop:dist": "npm run desktop:prepare && node scripts/build-desktop-package.mjs",
    "desktop:smoke:runtime": "node scripts/smoke-server-runtime.mjs dist-server/server.mjs",
    "desktop:smoke": "node scripts/smoke-packaged-desktop.mjs",
    "desktop:checksums": "node scripts/write-release-checksums.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.4.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12"
  },
  "main": "desktop-main.mjs",
  "build": {
    "appId": "com.locoris.server",
    "productName": "Locoris Server",
    "artifactName": "Locoris-Server-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "files": [
      "desktop-main.mjs",
      "desktop-preload.cjs",
      "desktop-port.mjs",
      "locales/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../TRADEMARKS.md",
        "to": "legal/TRADEMARKS.md"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release-server"
    },
    "mac": {
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "category": "public.app-category.productivity",
      "icon": "../app/src-tauri/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "../app/src-tauri/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "maintainer": "Locoris <support@locoris.app>",
      "executableName": "locoris-server",
      "icon": "../app/src-tauri/icons/128x128.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
