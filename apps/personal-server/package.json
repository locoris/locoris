{
  "name": "@locoris/personal-server",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "author": "Locoris",
  "description": "Private multi-vault self-hosted sync server for Locoris",
  "scripts": {
    "start": "node server.mjs",
    "sync-server": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:prepare": "node scripts/build-desktop-runtime.mjs",
    "desktop:dev": "npm run desktop:prepare && electron desktop-main.mjs",
    "desktop:dist": "npm run desktop:prepare && electron-builder --publish never",
    "desktop:checksums": "node scripts/write-release-checksums.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12"
  },
  "main": "desktop-main.mjs",
  "build": {
    "appId": "com.locoris.server",
    "productName": "Locoris Server",
    "artifactName": "Locoris-Server-${version}-${os}-${arch}.${ext}",
    "files": [
      "desktop-main.mjs",
      "dist-server/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release-server"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "../app/src-tauri/icons/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "../app/src-tauri/icons/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "icon": "../app/src-tauri/icons/128x128.png",
      "target": ["AppImage", "deb"]
    }
  }
}
